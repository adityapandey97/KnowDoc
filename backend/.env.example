# ==============================================================================
# KnowDoc Backend Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://knowdoc_user:knowdoc_password@localhost:5432/knowdoc?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowdoc
POSTGRES_USER=knowdoc_user
POSTGRES_PASSWORD=knowdoc_password
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Authentication & Security
JWT_SECRET=your-256-bit-jwt-secret-placeholder-minimum-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-placeholder-minimum-32-characters-long
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# File Storage Abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=data/storage
STORAGE_MAX_FILE_SIZE_MB=25

# GitHub Integration (Optional OAuth / Personal Access Token for repository ingestion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Logging
LOG_LEVEL=info

