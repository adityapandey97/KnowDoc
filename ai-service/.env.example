# ==============================================================================
# KnowDoc AI Microservice Environment Configuration Template
# ==============================================================================

SERVICE_NAME=knowdoc-ai-service
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Service-to-service authentication
INTERNAL_SERVICE_KEY=dev-internal-secret-change-in-production

# PostgreSQL / pgvector Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowdoc_vectors
POSTGRES_USER=knowdoc_vector_user
POSTGRES_PASSWORD=knowdoc_vector_password
VECTOR_DIMENSION=1536

# Model & Provider Configuration
# Options: "mock", "openai", "local"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# Options: "mock", "openai"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=45.0
OPENAI_API_KEY=your-openai-api-key-placeholder

# Chunking & Retrieval Parameters
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.50

# Agent Execution Limits
AGENT_MAX_ITERATIONS=4
AGENT_TOOL_TIMEOUT_SECONDS=15.0

