# ==============================================================================
# KnowDoc Environment Configuration Template
# NOTE: Copy this file to .env and replace placeholder values before running.
# Never commit .env with production credentials to version control.
# ==============================================================================

# Node / Express Backend Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Application Security & Tokens
JWT_ACCESS_SECRET=your-256-bit-jwt-access-secret-placeholder-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-256-bit-jwt-refresh-secret-placeholder-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_KEY=dev-internal-secret-change-in-production

# Primary Application Datastore (MongoDB)
MONGODB_URI=mongodb://knowdoc_user:knowdoc_password@localhost:27017/knowdoc?authSource=admin

# Vector Datastore (PostgreSQL with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowdoc_vectors
POSTGRES_USER=knowdoc_vector_user
POSTGRES_PASSWORD=knowdoc_vector_password
POSTGRES_MAX_CONNECTIONS=20
VECTOR_DIMENSION=1536

# Cache & Task Queue Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=data/storage
STORAGE_MAX_FILE_SIZE_MB=25

# Internal AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# LLM & Embedding Providers (FastAPI AI Service)
# Provider options: "openai", "local", "mock"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-placeholder

# Logging
LOG_LEVEL=info

